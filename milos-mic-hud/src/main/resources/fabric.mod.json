{
  "schemaVersion": 1,
  "id": "milos-mic-hud",
  "version": "${version}",
  "name": "Milo's Mic HUD",
  "description": "Shows a HUD icon for your Simple Voice Chat microphone state (unmuted/muted/disabled/disconnected), with each icon replaceable by your own PNG.",
  "authors": [
    "Milo"
  ],
  "contact": {
    "homepage": "https://github.com/kimparguld/milos-mods",
    "issues": "https://github.com/kimparguld/milos-mods/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "ru.berdinskiybear.michud.MicHudMod"
    ],
    "ukulib": [
      "ru.berdinskiybear.michud.config.UkulibIntegration"
    ]
  },
  "mixins": [
    "milos-mic-hud.mixins.json"
  ],
  "depends": {
    "minecraft": ">=1.21.11",
    "fabricloader": ">=0.17",
    "ukulib": "^1.10.0"
  }
}
